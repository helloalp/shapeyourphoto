            VALUE "ProductVersion", "1.2.7\0"
            VALUE "LegalCopyright", "Copyright (c) 2026 Francis Zhang & Helloalp. All rights reserved.\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
