        BEGIN
            VALUE "CompanyName", "Helloalp\0"
            VALUE "FileDescription", "ShapeYourPhoto Launcher\0"
            VALUE "FileVersion", "1.2.7.0\0"
            VALUE "InternalName", "ShapeYourPhoto\0"
